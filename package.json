{
  "name": "evido",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:todo": "turbo dev --filter=@evido/api --filter=@evido/auth-web --filter=@evido/todo-web",
    "dev:mail": "turbo dev --filter=@evido/api --filter=@evido/auth-web --filter=@evido/mail-web",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "turbo typecheck test build",
    "web:update": "node scripts/web-update.mjs",
    "db:generate": "pnpm --filter @evido/db db:generate",
    "db:migrate": "pnpm --filter @evido/db db:migrate",
    "db:deploy": "pnpm --filter @evido/db db:deploy",
    "db:deploy:prod": "pnpm --filter @evido/db db:deploy:prod",
    "db:studio": "pnpm --filter @evido/db db:studio",
    "dev:capture": "pnpm --filter @evido/capture-desktop app",
    "dev:desktop": "turbo dev app --filter=@evido/api --filter=@evido/auth-web --filter=@evido/desktop"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0"
  }
}
