{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@evido/mail-web/embed": ["./src/embeds/mail.d.ts"],
      "@evido/todo-web/embed": ["./src/embeds/todo.d.ts"],
      "@evido/notes-web/embed": ["./src/embeds/notes.d.ts"],
      "@evido/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src", "vite.ts"]
}
