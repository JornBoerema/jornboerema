// Shared database for all Evido apps (todo, mail, passwords, ...).
// Table and column names are snake_case and match the original "Even doen" app,
// so existing data can be copied over with a plain pg_dump/restore.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (Better Auth core) ────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessions               Session[]
  accounts               Account[]
  oauthClients           OauthClient[]
  oauthRefreshTokens     OauthRefreshToken[]
  oauthAccessTokens      OauthAccessToken[]
  oauthConsents          OauthConsent[]
  lists                  List[]
  workspaceMemberships   WorkspaceMember[]
  workspaceInvitations   WorkspaceInvitation[]
  mailAccounts           MailAccount[]
  mailMessages           MailMessage[]
  mailSignatures         MailSignature[]
  mailUploads            MailUpload[]
  mailOauthStates        MailOauthState[]
  appAccess              AppAccess[]
  appAccessRequests      AppAccessRequest[]
  mailPreferences        MailPreferences?
  mailShipments          MailShipment[]
  mailSnoozes            MailSnooze[]
  mailScheduledSends     MailScheduledSend[]
  mailInvoices           MailInvoice[]
  mailRecognitionReports MailRecognitionReport[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId], map: "session_user_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([userId], map: "account_user_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest Float  @map("last_request")

  @@map("rate_limit")
}

// ─── Auth (JWT + OAuth provider for MCP clients) ────────────────────────────
// Optional string arrays are Json? because Better Auth gives null a meaning
// ("unrestricted") that differs from [] and Prisma lists cannot hold null.

model Jwks {
  id         String    @id
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String    @id
  clientId                         String    @unique @map("client_id")
  clientSecret                     String?   @map("client_secret")
  clientDiscoveryId                String?   @map("client_discovery_id")
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?  @map("skip_consent")
  enableEndSession                 Boolean?  @map("enable_end_session")
  subjectType                      String?   @map("subject_type")
  scopes                           Json?
  clientCredentialsScopes          Json?     @map("client_credentials_scopes")
  userId                           String?   @map("user_id")
  user                             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime? @map("created_at")
  updatedAt                        DateTime? @map("updated_at")
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         Json?
  tos                              String?
  policy                           String?
  softwareId                       String?   @map("software_id")
  softwareVersion                  String?   @map("software_version")
  softwareStatement                String?   @map("software_statement")
  redirectUris                     String[]  @map("redirect_uris")
  postLogoutRedirectUris           Json?     @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?   @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?  @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?   @map("token_endpoint_auth_method")
  applicationType                  String?   @map("application_type")
  jwks                             String?
  jwksUri                          String?   @map("jwks_uri")
  grantTypes                       Json?     @map("grant_types")
  responseTypes                    Json?     @map("response_types")
  requirePKCE                      Boolean?  @map("require_p_k_c_e")
  dpopBoundAccessTokens            Boolean?  @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?   @map("reference_id")
  metadata                         Json?

  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@map("oauth_client")
}

model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?      @map("access_token_ttl")
  refreshTokenTtl               Int?      @map("refresh_token_ttl")
  signingAlgorithm              String?   @map("signing_algorithm")
  signingKeyId                  String?   @map("signing_key_id")
  allowedScopes                 Json?     @map("allowed_scopes")
  customClaims                  Json?     @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?  @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @map("created_at")
  updatedAt                     DateTime? @map("updated_at")
  policyVersion                 Int?      @default(1) @map("policy_version")
  metadata                      Json?

  clients OauthClientResource[]

  @@map("oauth_resource")
}

model OauthClientResource {
  id         String        @id
  clientId   String        @map("client_id")
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String        @map("resource_id")
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @map("created_at")

  @@unique([clientId, resourceId], map: "oauth_client_resource_unique")
  @@map("oauth_client_resource")
}

model OauthRefreshToken {
  id                      String      @id
  token                   String      @unique
  clientId                String      @map("client_id")
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?     @map("session_id")
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String      @map("user_id")
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?     @map("reference_id")
  authorizationCodeId     String?     @map("authorization_code_id")
  resources               Json?
  requestedUserInfoClaims Json?       @map("requested_user_info_claims")
  expiresAt               DateTime    @map("expires_at")
  createdAt               DateTime    @map("created_at")
  revoked                 DateTime?
  rotatedAt               DateTime?   @map("rotated_at")
  rotationReplayResponse  String?     @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime?   @map("rotation_replay_expires_at")
  authTime                DateTime?   @map("auth_time")
  confirmation            Json?
  scopes                  String[]

  accessTokens OauthAccessToken[]

  @@map("oauth_refresh_token")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String             @map("client_id")
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @map("session_id")
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @map("user_id")
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               Json?
  requestedUserInfoClaims Json?              @map("requested_user_info_claims")
  refreshId               String?            @map("refresh_id")
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime           @map("expires_at")
  createdAt               DateTime           @map("created_at")
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@map("oauth_access_token")
}

model OauthConsent {
  id                      String      @id
  clientId                String      @map("client_id")
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?     @map("user_id")
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?     @map("reference_id")
  resources               Json?
  requestedUserInfoClaims Json?       @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime    @map("created_at")
  updatedAt               DateTime    @map("updated_at")

  @@map("oauth_consent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @map("expires_at")

  @@map("oauth_client_assertion")
}

// ─── Todo app ───────────────────────────────────────────────────────────────

enum ListKind {
  todo
  note
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum ShareRole {
  viewer
  editor
}

/// A shared space (e.g. "Persoonlijk", "Werk"). Every member sees all its lists.
model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  lists       List[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([workspaceId, userId], map: "workspace_members_workspace_user_unique")
  @@index([userId], map: "workspace_members_user_idx")
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique @map("token_hash")
  invitedById String?       @map("invited_by_id")
  invitedBy   User?         @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  @@unique([workspaceId, email], map: "workspace_invitations_workspace_email_unique")
  @@map("workspace_invitations")
}

model List {
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Creator of the list. Access comes from workspace membership, not this field.
  userId      String?   @map("user_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  kind        ListKind  @default(todo)
  noteContent String    @default("") @map("note_content")
  noteVersion Int       @default(0) @map("note_version")
  /// Sidebar order within the workspace, per kind (lists and notes separately).
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  todos Todo[]
  link  ListLink?

  @@index([userId], map: "lists_user_idx")
  @@index([workspaceId], map: "lists_workspace_idx")
  @@map("lists")
}

model Todo {
  id         String    @id
  listId     String    @map("list_id")
  list       List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  title      String
  completed  Boolean   @default(false)
  inProgress Boolean   @default(false) @map("in_progress")
  position   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  mail       TodoMail?

  @@index([listId], map: "todos_list_idx")
  @@map("todos")
}

/// A conversation pinned to the top of the inbox. Ours alone: Gmail and Outlook don't pin.
model MailPin {
  id        String      @id
  userId    String      @map("user_id")
  accountId String      @map("account_id")
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId  String      @map("thread_id")
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([accountId, threadId], map: "mail_pins_thread_key")
  @@index([userId], map: "mail_pins_user_idx")
  @@map("mail_pins")
}

/// The mail a task was made from. Only its owner can open it; others see where it came from.
model TodoMail {
  todoId    String   @id @map("todo_id")
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  /// Whose mailbox it is in.
  userId    String   @map("user_id")
  accountId String   @map("account_id")
  /// The provider's conversation id, which outlives our synced rows.
  threadId  String   @map("thread_id")
  subject   String
  fromName  String?  @map("from_name")
  fromEmail String?  @map("from_email")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId, threadId], map: "todo_mails_thread_idx")
  @@map("todo_mails")
}

/// A random bearer link grants access to one list, independently of accounts.
model ListLink {
  listId    String    @id @map("list_id")
  list      List      @relation(fields: [listId], references: [id], onDelete: Cascade)
  token     String    @unique
  role      ShareRole
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("list_links")
}

// ─── Mail app ───────────────────────────────────────────────────────────────

enum MailProvider {
  gmail
  outlook
}

enum MailAccountStatus {
  active
  reauth_required
}

/// A connected mailbox. Separate from `account`, which is for signing in to Evido.
model MailAccount {
  id                   String              @id
  userId               String              @map("user_id")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             MailProvider
  providerAccountId    String              @map("provider_account_id")
  email                String
  displayName          String?             @map("display_name")
  /// Sealed with MAIL_TOKEN_KEY (see @evido/mail-core/secrets). Never plaintext.
  accessToken          String              @map("access_token_sealed")
  refreshToken         String              @map("refresh_token_sealed")
  accessTokenExpiresAt DateTime            @map("access_token_expires_at")
  scope                String
  status               MailAccountStatus   @default(active)
  /// Index into the client's palette; tells mailboxes apart in a shared list.
  color                Int                 @default(0)
  /// Signature for new messages from this mailbox. Null means none.
  signatureNewId       String?             @map("signature_new_id")
  signatureNew         MailSignature?      @relation("SignatureForNew", fields: [signatureNewId], references: [id], onDelete: SetNull)
  /// Signature for replies and forwards from this mailbox. Null means none.
  signatureReplyId     String?             @map("signature_reply_id")
  signatureReply       MailSignature?      @relation("SignatureForReply", fields: [signatureReplyId], references: [id], onDelete: SetNull)
  /// Opaque provider position (Gmail history id, Graph delta link). Null until the first sync.
  syncCursor           String?             @map("sync_cursor")
  /// Oldest mail this account keeps. Fixed when a full sync starts.
  syncSince            DateTime?           @map("sync_since")
  /// Lease so two tabs or functions cannot advance the same cursor at once.
  syncLockedUntil      DateTime?           @map("sync_locked_until")
  /// Graph subscription id. Gmail watches have no id and are found by mailbox address.
  watchId              String?             @map("watch_id")
  watchExpiresAt       DateTime?           @map("watch_expires_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at")
  messages             MailMessage[]
  summaries            MailSummary[]
  shipments            MailShipment[]
  snoozes              MailSnooze[]
  scheduledSends       MailScheduledSend[]
  invoices             MailInvoice[]
  pins                 MailPin[]

  @@unique([userId, provider, providerAccountId], map: "mail_accounts_user_provider_account_unique")
  @@index([watchId], map: "mail_accounts_watch_id_idx")
  @@map("mail_accounts")
}

/// A signature the user wrote; mailboxes pick which one they use.
model MailSignature {
  id         String        @id
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// HTML from the app's own editor.
  html       String
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")
  forNew     MailAccount[] @relation("SignatureForNew")
  forReplies MailAccount[] @relation("SignatureForReply")

  @@index([userId, createdAt], map: "mail_signatures_user_created_idx")
  @@map("mail_signatures")
}

/// What the reading pane shows above a conversation, made once per newest message
/// and language. The summary is a few sentences derived from the mail.
model MailSummary {
  id        String      @id
  accountId String      @map("account_id")
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId  String      @map("thread_id")
  /// The conversation's newest message when this was made; a reply makes a new one.
  messageId String      @map("message_id")
  language  String
  /// A one-time code in the newest message, found without a model.
  code      String?
  /// Null until a model was asked; then the summary, or empty when it had none.
  summary   String?
  /// Null until a model was asked; then up to three reply suggestions, empty when it needs none.
  replies   Json?
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([accountId, threadId, messageId, language], map: "mail_summaries_key")
  @@map("mail_summaries")
}

/// The parcel a shipping conversation is about: carrier, tracking code and link,
/// and status, as its mail says. Never the mail itself. One row per conversation,
/// made again when a newer message arrives; `found` false marks one read for
/// nothing, so it isn't read again.
model MailShipment {
  id           String      @id
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String      @map("account_id")
  account      MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId     String      @map("thread_id")
  /// The newest message read, by its provider id.
  messageId    String      @map("message_id")
  /// Which version of the reading found this; a better one reads the mail again.
  readVersion  Int         @default(1) @map("read_version")
  found        Boolean
  carrier      String?
  trackingCode String?     @map("tracking_code")
  trackingUrl  String?     @map("tracking_url")
  merchant     String?
  /// The shop's order number: mails about one order with different codes belong together.
  orderNumber  String?     @map("order_number")
  status       String?
  subject      String
  receivedAt   DateTime    @map("received_at")
  /// Reported as recognised wrongly: out of the list, and not read again.
  dismissed    Boolean     @default(false)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")

  @@unique([accountId, threadId], map: "mail_shipments_thread_key")
  @@index([userId, receivedAt(sort: Desc)], map: "mail_shipments_user_received_idx")
  @@map("mail_shipments")
}

/// What an invoice, receipt or payment request in a conversation says: who,
/// how much, by when, paid or not. Never the mail itself. One row per
/// conversation, made again when it grows or the reading improves.
model MailInvoice {
  id            String      @id
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String      @map("account_id")
  account       MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId      String      @map("thread_id")
  messageId     String      @map("message_id")
  readVersion   Int         @default(1) @map("read_version")
  found         Boolean
  vendor        String?
  amountCents   Int?        @map("amount_cents")
  currency      String?
  dueDate       String?     @map("due_date")
  invoiceNumber String?     @map("invoice_number")
  payUrl        String?     @map("pay_url")
  status        String?
  overdue       Boolean     @default(false)
  subject       String
  receivedAt    DateTime    @map("received_at")
  /// Reported as recognised wrongly: out of the list, and not read again.
  dismissed     Boolean     @default(false)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")

  @@unique([accountId, threadId], map: "mail_invoices_thread_key")
  @@index([userId, receivedAt(sort: Desc)], map: "mail_invoices_user_received_idx")
  @@map("mail_invoices")
}

/// A user saying a parcel or invoice was recognised wrongly, to improve the
/// reading. Only the subject, the sender's domain and what was found are kept,
/// never the mail.
model MailRecognitionReport {
  id         String   @id
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "parcel" or "invoice".
  kind       String
  /// What was wrong: not_one, amount, status, other.
  reason     String
  subject    String
  fromDomain String?  @map("from_domain")
  /// The fields the reading found, as it found them.
  found      Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt(sort: Desc)], map: "mail_recognition_reports_kind_created_idx")
  @@map("mail_recognition_reports")
}

/// A conversation put away until later: archived at the provider, and moved
/// back to the inbox at `until`. Kept a while after waking, so the inbox can
/// show it on top until it is read.
model MailSnooze {
  id        String      @id
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String      @map("account_id")
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  threadId  String      @map("thread_id")
  until     DateTime
  wokeAt    DateTime?   @map("woke_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([accountId, threadId], map: "mail_snoozes_thread_key")
  @@index([until], map: "mail_snoozes_until_idx")
  @@index([userId, until], map: "mail_snoozes_user_until_idx")
  @@map("mail_snoozes")
}

/// A draft at the provider to be sent at `sendAt`. What it says lives in the
/// draft; only what the Scheduled list shows is kept here.
model MailScheduledSend {
  id          String      @id
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String      @map("account_id")
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  draftId     String      @map("draft_id")
  sendAt      DateTime    @map("send_at")
  subject     String
  /// Name and address pairs, for the list line.
  toAddresses Json        @default("[]") @map("to_addresses")
  /// Set when sending failed, with the reason, so the list can say so.
  failedAt    DateTime?   @map("failed_at")
  error       String?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([accountId, draftId], map: "mail_scheduled_sends_draft_key")
  @@index([sendAt], map: "mail_scheduled_sends_send_at_idx")
  @@map("mail_scheduled_sends")
}

/// A file on its way into a message, sent in chunks because one request may
/// carry 4.5 MB at most. Removed once sent, or after two days.
model MailUpload {
  id          String            @id
  userId      String            @map("user_id")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  contentType String            @map("content_type")
  /// In bytes; the upload is complete once its chunks add up to this.
  size        Int
  createdAt   DateTime          @default(now()) @map("created_at")
  chunks      MailUploadChunk[]

  @@index([createdAt], map: "mail_uploads_created_idx")
  @@map("mail_uploads")
}

model MailUploadChunk {
  uploadId String     @map("upload_id")
  upload   MailUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  index    Int
  data     Bytes

  @@id([uploadId, index])
  @@map("mail_upload_chunks")
}

/// A pending OAuth connect flow. `id` is the SHA-256 of the state value.
model MailOauthState {
  id           String       @id
  userId       String       @map("user_id")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     MailProvider
  codeVerifier String       @map("code_verifier_sealed")
  expiresAt    DateTime     @map("expires_at")

  @@index([expiresAt], map: "mail_oauth_states_expires_idx")
  @@map("mail_oauth_states")
}

enum MailMessageFolder {
  inbox
  sent
  archive
  spam
  trash

  @@map("mail_message_folder")
}

/// List metadata of every synced folder. Bodies and attachments stay at the provider.
model MailMessage {
  /// Derived from account and provider id, so re-syncing keeps the same id.
  id                String            @id
  userId            String            @map("user_id")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String            @map("account_id")
  account           MailAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerMessageId String            @map("provider_message_id")
  threadId          String?           @map("thread_id")
  /// Where it sits; Gmail labels are mapped onto these.
  folder            MailMessageFolder @default(inbox)
  /// Name and address pairs, for naming who sent mail went to.
  toAddresses       Json              @default("[]") @map("to_addresses")
  subject           String
  snippet           String
  fromName          String?           @map("from_name")
  fromEmail         String?           @map("from_email")
  receivedAt        DateTime          @map("received_at")
  isRead            Boolean           @map("is_read")
  isStarred         Boolean           @map("is_starred")
  hasAttachments    Boolean           @map("has_attachments")

  @@unique([accountId, providerMessageId], map: "mail_messages_account_provider_unique")
  @@index([userId, receivedAt(sort: Desc), id(sort: Desc)], map: "mail_messages_user_received_idx")
  @@index([accountId, receivedAt(sort: Desc), id(sort: Desc)], map: "mail_messages_account_received_idx")
  @@index([userId, folder, receivedAt(sort: Desc), id(sort: Desc)], map: "mail_messages_user_folder_received_idx")
  @@index([accountId, threadId], map: "mail_messages_account_thread_idx")
  @@map("mail_messages")
}

/// Who may use an invite-only app ("mail"). Apps not listed as invite-only ignore it.
model AppAccess {
  userId    String   @map("user_id")
  app       String
  grantedAt DateTime @default(now()) @map("granted_at")
  /// The admin's email, or null when granted by the system (such as existing users).
  grantedBy String?  @map("granted_by")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, app])
  @@index([app])
  @@map("app_access")
}

/// An email address invited to an app. Signing in with it, verified, grants access.
model AppInvite {
  id         String    @id
  app        String
  /// Lowercased.
  email      String
  invitedBy  String?   @map("invited_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  @@unique([app, email])
  @@map("app_invites")
}

/// Someone signed in who asked to be let into an invite-only app.
model AppAccessRequest {
  id        String   @id
  app       String
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([app, userId])
  @@index([app])
  @@map("app_access_requests")
}

/// Mail settings that follow the account to every device. Notifications stay per browser.
model MailPreferences {
  userId           String   @id @map("user_id")
  summaries        Boolean  @default(true)
  codes            Boolean  @default(true)
  aiWriting        Boolean  @default(true) @map("ai_writing")
  remoteImages     Boolean  @default(false) @map("remote_images")
  /// Parcels from shipping mail; off reads no shipping mail and keeps none of it.
  parcels          Boolean  @default(true)
  /// The Unsubscribe button beside mail from a mailing list.
  unsubscribe      Boolean  @default(true)
  /// Tidy up: the inbox per sender, to archive, mark read or unsubscribe at once.
  senders          Boolean  @default(true)
  /// Invoices and payments from mail; off reads none of it and keeps none of it.
  invoices         Boolean  @default(true)
  /// "Make a task" on a mail, for Even doen, and the tasks made from it above the mail.
  todos            Boolean  @default(true)
  /// Pinning conversations to the top of the inbox.
  pins             Boolean  @default(true)
  /// Three replies written by a model, under mail that asks for an answer.
  replySuggestions Boolean  @default(true) @map("reply_suggestions")
  /// The sidebar as arranged: { main, more, hidden }, each a list of places; null is the default.
  sidebar          Json?
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mail_preferences")
}
