    "lint": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@even/auth": "workspace:*",
    "@even/i18n": "workspace:*",
    "@even/mail-core": "workspace:*",
    "@even/ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-query": "^5.105.0",
    "better-auth": "^1.7.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "~6.0.2",
