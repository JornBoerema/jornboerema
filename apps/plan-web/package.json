{
  "name": "@even/plan-web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Even plannen: the calendars of your Gmail and Outlook mailboxes, one of the apps in the Even shell (app.jornboerema.nl and the desktop app). It has no site of its own; ./embed is what the shell mounts.",
