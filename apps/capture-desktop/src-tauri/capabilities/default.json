{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Editor, overlay, preview, settings and permission windows",
  "windows": ["editor-*", "overlay-*", "preview-*", "permission", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
