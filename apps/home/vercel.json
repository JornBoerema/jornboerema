{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/admin", "destination": "https://app.jornboerema.nl/admin", "permanent": true },
    { "source": "/admin/:path*", "destination": "https://app.jornboerema.nl/admin/:path*", "permanent": true }
  ]
}
