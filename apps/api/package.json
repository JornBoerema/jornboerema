{
  "name": "@evido/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Hono API for all Evido apps: auth, todo, MCP.",
  "scripts": {
    "dev": "tsx watch --include ../../.env --env-file-if-exists=../../.env src/index.ts",
    "build": "pnpm --filter @evido/db db:generate && tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/mcp": "^1.7.14",
    "@evido/auth": "workspace:*",
    "@evido/db": "workspace:*",
    "@evido/email": "workspace:*",
    "@evido/i18n": "workspace:*",
    "@evido/mail-core": "workspace:*",
    "@evido/todo-core": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/server": "^2.4.0",
    "@trigger.dev/sdk": "4.8.4",
    "@vercel/functions": "^3.10.4",
    "ably": "^2.30.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.8.4",
    "@types/node": "^24",
    "trigger.dev": "4.8.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
