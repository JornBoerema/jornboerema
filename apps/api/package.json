{
  "name": "@even/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Hono API for all Even apps: auth, todo, mail.",
  "scripts": {
    "dev": "tsx watch --include ../../.env --env-file-if-exists=../../.env src/index.ts",
    "build": "pnpm --filter @even/db db:generate && tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@even/auth": "workspace:*",
    "@even/db": "workspace:*",
    "@even/email": "workspace:*",
    "@even/i18n": "workspace:*",
    "@even/mail-core": "workspace:*",
    "@even/realtime": "workspace:*",
    "@even/todo-core": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@neon/realtime": "0.2.1",
    "@sentry/hono": "11.12.0",
    "@sentry/node": "11.12.0",
    "@trigger.dev/sdk": "4.8.4",
    "@vercel/functions": "^3.10.4",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.8.4",
    "@types/node": "^24",
    "trigger.dev": "4.8.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
