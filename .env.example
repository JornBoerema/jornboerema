# ─────────────────────────────────────────────────────────────────────────────
# Evido monorepo — one .env at the repo root, shared by API and packages.
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Neon: pooled connection string (host contains "-pooler"), with sslmode=require.
DATABASE_URL=
# Neon: direct (unpooled) connection string, used by Prisma migrations.
DATABASE_URL_UNPOOLED=

# Public origin of the API (Hono), no trailing slash.
BETTER_AUTH_URL=http://localhost:4000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Web front-ends allowed to call the API with cookies (comma separated).
TRUSTED_ORIGINS=http://localhost:3000
# Web app that hosts the login/consent screens (used for OAuth/MCP redirects).
AUTH_UI_URL=http://localhost:3000
# Todo web app origin (used in invitation e-mails).
TODO_WEB_URL=http://localhost:3000
# Mail web app origin (the OAuth callback returns here). Also add it to TRUSTED_ORIGINS.
MAIL_WEB_URL=http://localhost:3004
# Production only: share the session across subdomains, e.g. .evido.nl
AUTH_COOKIE_DOMAIN=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Evido <noreply@your-verified-domain.nl>

# Ably (optional realtime; without it clients poll every 60s).
ABLY_API_KEY=

# Mail app: connecting Gmail and Outlook mailboxes.
# Seals OAuth tokens at rest. Generate with: openssl rand -hex 32. Losing it means reconnecting every mailbox.
MAIL_TOKEN_KEY=
# Google Cloud OAuth client. Redirect URI: <BETTER_AUTH_URL>/api/mail/callback/gmail
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# Microsoft Entra app (accounts in any org + personal). Redirect URI: <BETTER_AUTH_URL>/api/mail/callback/outlook
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=

API_PORT=4000
