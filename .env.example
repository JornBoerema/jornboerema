# ─────────────────────────────────────────────────────────────────────────────
# Evido monorepo — one .env at the repo root, shared by API and packages.
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Neon "dev" branch: pooled connection string (host contains "-pooler"), with sslmode=require.
DATABASE_URL=
# Neon "dev" branch: direct (unpooled) connection string, used by Prisma migrations.
DATABASE_URL_UNPOOLED=
# Neon "production" branch, direct and pooled. Only pnpm db:deploy:prod uses the direct one.
PROD_DATABASE_URL=
PROD_DATABASE_URL_UNPOOLED=

# Public origin of the API (Hono), no trailing slash.
BETTER_AUTH_URL=http://localhost:4000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Web front-ends allowed to call the API with cookies (comma separated).
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3006,http://localhost:1430
# The account site (apps/auth-web): login, OAuth consent and account screens. Trusted automatically.
AUTH_UI_URL=http://localhost:3005
# Todo web app origin (used in invitation e-mails).
TODO_WEB_URL=http://localhost:3000
# Mail web app origin (the OAuth callback returns here). Trusted automatically.
MAIL_WEB_URL=http://localhost:3004
NOTES_WEB_URL=http://localhost:3006
# Production only: share the session across subdomains, e.g. .evido.nl
AUTH_COOKIE_DOMAIN=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Evido <noreply@your-verified-domain.nl>

# Neon Realtime (optional; without it clients poll every 60s). Console: database > Realtime.
# The database must be the one in DATABASE_URL; NEON_REALTIME_DB overrides its name.
NEON_REALTIME_SECRET=
NEON_REALTIME_URL=

# Mail app: connecting Gmail and Outlook mailboxes.
# Seals OAuth tokens at rest. Generate with: openssl rand -hex 32. Losing it means reconnecting every mailbox.
MAIL_TOKEN_KEY=
# Google Cloud OAuth client. Redirect URI: <BETTER_AUTH_URL>/api/mail/callback/gmail
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# Random secret in the Gmail Pub/Sub push URL; also derives the Graph client state.
MAIL_WEBHOOK_SECRET=
# Vercel Cron sends this as a bearer token when renewing mailbox notifications.
CRON_SECRET=
# projects/<google-cloud-project>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
# Microsoft Entra app (accounts in any org + personal). Redirect URI: <BETTER_AUTH_URL>/api/mail/callback/outlook
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=

# Opening Even mailen. Unset, it is invite-only as a whole.
# 1 = anyone may use it with Outlook; Gmail then takes its own invitation.
MAIL_OPEN=
# 1 = it takes a subscription (needs the Stripe keys below). People the admin invited use it free.
MAIL_PAID=
# US dollars one user may cost in AI per month (default 5; 0 = no limit), and mails per day (default 400).
AI_MONTHLY_LIMIT_USD=
MAIL_DAILY_SEND_LIMIT=

# Stripe. Set the account up once with `node scripts/stripe-setup.mjs` (product, prices, portal, webhook).
# Webhook: <BETTER_AUTH_URL>/api/auth/stripe/webhook. Locally: `stripe listen --all-snapshot --forward-to localhost:4000/api/auth/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 = have Stripe Tax work out VAT per country. Only after adding a tax registration at Stripe.
STRIPE_AUTOMATIC_TAX=

# Sentry: errors from the API. Unset, nothing is reported.
SENTRY_DSN=

API_PORT=4000
